{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user basic information and settings.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "User profile photo URL" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of creation" }
      },
      "required": ["uid", "email"]
    },
    "PrashnaHistory": {
      "title": "Prashna History",
      "description": "Stores past Prashna queries and their AI-generated predictions.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner UID" },
        "data": { "type": "object", "description": "The Prashna input data" },
        "result": { "type": "object", "description": "The AI generated prediction result" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of query" }
      },
      "required": ["uid", "data", "result"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "User profile documents"
    },
    "/prashna_history/{id}": {
      "schema": "PrashnaHistory",
      "description": "History of Prashna queries"
    }
  }
}
